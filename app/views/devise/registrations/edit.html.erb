<div class="max-w-7xl mx-auto py-3 sm:px-6 lg:px-8">
  <div class="px-4 sm:px-0">
    <div class="p-6 border border-gray-200 rounded-2xl shadow-lg bg-white">
      <!-- Form Heading -->
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Sign up</h2>
      </div>

      <!-- Form -->
      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <%= f.error_notification %>

        <!-- Email -->
        <div>
          <%= f.input :email,
                      required: true,
                      autofocus: true,
                      label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                      input_html: { class: "input-field" } %>
        </div>

        <!-- First Name -->
        <div>
          <%= f.input :first_name,
                      required: true,
                      autofocus: true,
                      label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                      input_html: { class: "input-field" } %>
        </div>

        <!-- Last Name -->
        <div>
          <%= f.input :last_name,
                      required: true,
                      autofocus: true,
                      label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                      input_html: { class: "input-field" } %>
        </div>

        <!-- Password -->
        <div>
          <%= f.input :password,
                      required: true,
                      hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                      label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                      input_html: { class: "input-field" } %>
        </div>

        <!-- Password Confirmation -->
        <div>
          <%= f.input :password_confirmation,
                      required: true,
                      label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                      input_html: { class: "input-field" } %>
        </div>

        <!-- Avatar -->
        <div>
          <label for="avatar" class="block text-sm font-medium text-gray-700 mb-1">Avatar</label>
          <%= f.input :avatar, as: :file, input_html: { class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border file:border-gray-300 file:text-sm file:font-medium file:bg-secondary file:text-white hover:file:bg-secondary-light" } %>
        </div>

        <!-- Submit Button -->
        <div class="form-actions mt-6">
          <%= f.button :submit, "Submit edits", class: "btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
