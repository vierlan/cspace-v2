<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
  <!-- Page Title -->
  <h1 class="font-heading text-3xl font-bold text-gray-900 mb-6">Package Details</h1>

  <div class="flex flex-col lg:flex-row gap-6">
    <!-- Package Information -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-lg p-6 w-full lg:w-1/2">
      <h2 class="text-xl font-semibold text-gray-800 mb-4"><%= @package.package_name.capitalize %></h2>
      <p class="text-gray-600 mb-4"><%= @package.package_description %></p>
      <% if @package.package_duration %>
        <p class="text-gray-500 mb-2">Duration: <%= "#{@package.package_duration} hours" %></p>
      <% end %>
      <p class="text-gray-500 font-semibold">Price: €<%= @package.package_price %></p>
      <% if @package.photo.key %>
        <div class="mt-6">
          <%= cl_image_tag @package.photo.key, alt: @package.package_name, class: "object-cover w-full h-64 rounded-lg" %>
        </div>
      <% end %>
    </div>

    <!-- Booking Form -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-lg p-6 w-full lg:w-1/2">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Book this Venue</h2>
      <%= render 'bookings/form', booking: @booking, package: @package, venue: @venue %>
    </div>
  </div>
</div>
