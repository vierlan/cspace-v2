<div class="max-w-7xl mx-5 py-6 sm:px-6 lg:px-8">
  <!-- Page Title -->
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Dashboard: My Venues</h1>

  <!-- Venues List -->
  <ul class="space-y-6">
    <% @venues.each do |venue| %>
      <li>
        <div class="bg-white border border-gray-200 rounded-xl shadow-lg p-6 grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
          <!-- Venue Information -->
          <div class="space-y-2">
            <h2 class="text-xl font-semibold text-gray-800">
              <%= link_to venue.name, edit_venue_path(venue), class: "hover:underline" %>
            </h2>
            <p class="text-gray-500"><%= venue.address %></p>
          </div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row sm:space-x-4 lg:justify-end">
            <%= link_to "Add items for sale", new_venue_package_path(venue), class: "btn-primary mb-4 sm:mb-0 sm:w-auto lg:w-auto text-center" %>
            <%= link_to "View and edit packages", my_venue_packages_path(venue), class: "btn-primary sm:w-auto lg:w-auto text-center" %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</div>
