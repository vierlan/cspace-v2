<%= render partial: "shared/heading", locals: { title: 'Dashboard', description: '' } %>
<main>
  <div class="max-w-7xl mx-auto py-3 sm:px-6 lg:px-8">
    <div class="px-4 sm:px-0">
      <div class=" p-4 border border-gray-200 rounded-2xl shadow-lg h-auto bg-white">
        <div class="flex justify-center items-center h-full">
          <div class="text-center space-y-6">
            <!-- Heading -->
            <h2 class="text-5xl font-heading font-bold text-gray-900">
              Hi
                <%= @user.full_name %>
            </h2>

            <!-- Subtitle -->
            <p class="mt-2 text-lg text-gray-600">
              Here you can manage your bookings, see your profile and more.
            </p>

            <!-- Button Section -->
            <div class="mt-6 mx-auto max-w-fit">
              <ul class="flex flex-col items-start space-y-4 mb-4">
                <li>
                  <%= link_to edit_user_registration_path, class: "btn-primary" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
                    </svg>
                    <span>Finish or edit your Profile set-up</span>
                  <% end %>
                </li>
                </ul>


            <!-- Conditional Dashboard Rendering -->

            <ul class="flex flex-col items-start space-y-4">
              <% if @user.admin? %>
                <%= render "admin_dash" %>
              <% elsif @user.venue_owner %>
                <%= render "venue_owner_dash" %>
              <% else %>
                <%= render "user_dash" %>
              <% end %>
            </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
