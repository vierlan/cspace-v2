<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
  <!-- Page Title -->
  <h1 class="font-heading text-3xl font-bold text-gray-900 mb-6">Booking Details</h1>

  <!-- Booking Information -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-lg p-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-4"><%= @booking.venue.name %></h2>

    <!-- Booking Details -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Left Column -->
      <div>
        <p class="text-gray-600 mb-2"><strong>Package:</strong> <%= @booking.package.package_name %></p>
        <p class="text-gray-600 mb-2"><strong>Date:</strong> <%= @booking.booking_date.strftime("%A, %d %b %Y") %></p>
        <p class="text-gray-600 mb-2"><strong>Start Time:</strong> <%= @booking.booking_start_time.strftime("%H:%M") %></p>
        <p class="text-gray-600 mb-2"><strong>Cost:</strong> €<%= @booking.booking_cost %></p>
        <p class="text-gray-600 mb-2">
          <strong>Status:</strong>
          <span class="<%= @booking.booking_confirmed ? 'text-green-600' : 'text-red-600' %>">
            <%= @booking.booking_confirmed ? 'Confirmed' : 'Pending' %>
          </span>
        </p>
        <p class="text-gray-600">
          <strong>Payment:</strong>
          <span class="<%= @booking.booking_paid ? 'text-green-600' : 'text-red-600' %>">
            <%= @booking.booking_paid ? 'Paid' : 'Unpaid' %>
          </span>
        </p>
      </div>

      <!-- Right Column -->
      <div class="flex flex-col space-y-4">
        <% if @booking.package.photo.key %>
          <div>
            <%= cl_image_tag @booking.package.photo.key, alt: @booking.package.package_name, class: "object-cover w-full h-64 rounded-lg" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-6 flex space-x-4">
      <%= link_to "Edit Booking", edit_booking_path(@booking.venue, @booking.package, @booking), class: "btn-primary px-4 py-2" %>
      <%= link_to "Cancel Booking", booking_path(@booking.venue, @booking.package, @booking), method: :delete, data: { confirm: "Are you sure you want to cancel this booking?" }, class: "btn-danger px-4 py-2" %>
    </div>
  </div>
</div>
