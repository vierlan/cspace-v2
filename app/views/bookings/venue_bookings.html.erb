<div>
  <%= column_chart Booking.joins(venue: :user).where(users: { id: current_user.id }).pluck(:booking_date).map(&:to_date).sort.tally %>
</div>
<div class="overflow-x-auto">
  <table class="table table-striped table-sm mt-2">
    <thead>
      <tr>
        <th>Venue Name</th>
        <th>Package Name</th>
        <th>Booking Date</th>
        <th>Start Time</th>
        <th>Cost</th>
        <th>Confirmed</th>
        <th>Paid</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @current_bookings.each do |booking| %>
        <tr>
          <td><%= booking.venue.name %></td>
          <td><%= booking.package.package_name %></td>
          <td><%= booking.booking_date.strftime("%A, %d %b %Y") %></td>
          <td><%= booking.booking_start_time.strftime("%H:%M") %></td>
          <td><%= number_to_currency(booking.booking_cost) %></td>
          <td>
            <%= booking.booking_confirmed ? "✅ Yes" : "❌ No" %>
          </td>
          <td>
            <%= booking.booking_paid ? "✅ Yes" : "❌ No" %>
          </td>
          <td>
            <div class="flex space-x-2">
              <%#= link_to "Edit", edit_booking_path(booking.venue, booking.package, booking), class: "btn btn-primary btn-sm" %>
              <%#= link_to "Delete", booking_path(booking.venue, booking.package, booking),
                  method: :delete, data: { confirm: "Are you sure?" },
                  class: "btn btn-danger btn-sm" %>
              <% unless booking.booking_confirmed %>
                <%= button_to "Confirm", confirm_booking_path(booking),
                      method: :patch,
                      data: { turbo_confirm: "Are you sure you want to confirm this booking?" },
                      class: "btn btn-success btn-sm" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

  <div class="flex flex-wrap">
  <h2>Booking History</h2>
  <table>
    <tbody>
      <% @past_bookings.each do |booking| %>
        <tr>
          <td><%= booking.venue.name %></td>
          <td><%= booking.package.package_name %></td>
          <td><%= booking.booking_date.strftime("%A, %d %b %Y") %></td>
          <td><%= booking.booking_start_time.strftime("%H:%M") %></td>
          <td><%= booking.booking_cost %></td>
          <td><%= booking.booking_confirmed %></td>
          <td><%= booking.booking_paid %></td>
          <td><%= link_to "Edit", edit_booking_path(booking.venue, booking.package, booking), class: "btn btn-primary" %></td>
          <td><%= link_to "Delete", booking_path(booking.venue, booking.package, booking), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
