<div class="max-w-7xl mx-5 py-6 sm:px-6 lg:px-8">
  <!-- Current Bookings Section -->
  <h2 class="text-2xl font-bold text-gray-800 mb-4">View and Change Your Bookings</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

  <% headings = ["Venue Name", "Package Name", "Booking Date", "Booking Cost", "Confirmed", ] %>
    <% @current_bookings.each do |booking| %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-lg p-6 space-y-4">
        <!-- Venue Name -->
        <h3 class="text-lg font-semibold text-gray-900"><%= booking.venue.name %></h3>
        <!-- Package Name -->
        <p class="text-gray-600"><strong>Package:</strong> <%= booking.package.package_name %></p>
        <!-- Booking Date -->
        <p class="text-gray-600"><strong>Date:</strong> <%= booking.booking_date.strftime("%A, %d %b %Y") %></p>
        <!-- Booking Time -->
        <p class="text-gray-600"><strong>Time:</strong> <%= booking.booking_start_time.strftime("%H:%M") %></p>
        <!-- Booking Cost -->
        <p class="text-gray-600"><strong>Cost:</strong> €<%= booking.booking_cost %></p>
        <!-- Booking Status -->
        <p class="text-gray-600">
          <strong>Status:</strong>
          <span class="<%= booking.booking_confirmed ? 'text-green-600' : 'text-red-600' %>">
            <%= booking.booking_confirmed ? 'Confirmed' : 'Pending' %>
          </span>
        </p>
        <!-- Payment Status -->
        <p class="text-gray-600">
          <strong>Payment:</strong>
          <span class="<%= booking.booking_paid ? 'text-green-600' : 'text-red-600' %>">
            <%= booking.booking_paid ? 'Paid' : 'Unpaid' %>
          </span>
        </p>
        <!-- Actions -->
        <div class="flex justify-between">
          <%= link_to "Edit", edit_booking_path(booking.venue, booking.package, booking), class: "btn-primary w-full mr-2" %>
          <%= link_to "Delete", booking_path(booking.venue, booking.package, booking), method: :delete, data: { confirm: "Are you sure?" }, class: "btn-danger w-full" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Booking History Section -->
  <h2 class="text-2xl font-bold text-gray-800 my-6">Booking History</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @past_bookings.each do |booking| %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-lg p-6 space-y-4">
        <!-- Venue Name -->
        <h3 class="text-lg font-semibold text-gray-900"><%= booking.venue.name %></h3>
        <!-- Package Name -->
        <p class="text-gray-600"><strong>Package:</strong> <%= booking.package.package_name %></p>
        <!-- Booking Date -->
        <p class="text-gray-600"><strong>Date:</strong> <%= booking.booking_date.strftime("%A, %d %b %Y") %></p>
        <!-- Booking Time -->
        <p class="text-gray-600"><strong>Time:</strong> <%= booking.booking_start_time.strftime("%H:%M") %></p>
        <!-- Booking Cost -->
        <p class="text-gray-600"><strong>Cost:</strong> €<%= booking.booking_cost %></p>
        <!-- Booking Status -->
        <p class="text-gray-600">
          <strong>Status:</strong>
          <span class="<%= booking.booking_confirmed ? 'text-green-600' : 'text-red-600' %>">
            <%= booking.booking_confirmed ? 'Confirmed' : 'Pending' %>
          </span>
        </p>
        <!-- Payment Status -->
        <p class="text-gray-600">
          <strong>Payment:</strong>
          <span class="<%= booking.booking_paid ? 'text-green-600' : 'text-red-600' %>">
            <%= booking.booking_paid ? 'Paid' : 'Unpaid' %>
          </span>
        </p>
        <!-- Actions -->
        <div class="flex justify-between">
          <%= link_to "Edit", edit_booking_path(booking.venue, booking.package, booking), class: "btn-primary w-full mr-2" %>
          <%= link_to "Delete", booking_path(booking.venue, booking.package, booking), method: :delete, data: { confirm: "Are you sure?" }, class: "btn-danger w-full" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
