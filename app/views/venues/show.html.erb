    <%= render "map", venues: @venues %>

<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
  <!-- Venue Information -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-lg p-6 m-3">
    <h2 class="text-xl font-heading font-semibold text-gray-800 mb-4"><%= @venue.name %></h2>
    <% if @venue.photos.attached? %>
      <div class="rounded-xl overflow-hidden mb-4">
        <%= render partial: "venue_show_template", locals: {venue: @venue, venue_owner: @venue_owner} %>
      </div>
    <% else %>
      <p class="text-gray-600">No venues found.</p>
    <% end %>
    <p class="text-pink-800 text-sm font-medium mt-4">
      <%= @venue.categories.capitalize if @venue.categories.present? %>
      <%= " • " + @rating.to_s + " " + ("⭐" * @rating.to_i) %>

    </p>
    <p class="text-gray-600 mt-2">
      <i class="fa-solid fa-location-dot text-pink-800"></i> <%= @venue.address %>
    </p>
    <div class="mt-6 flex items-center space-x-6">
      <div class="flex items-center space-x-2 text-pink-800">
        <i class="fa-solid fa-person-walking text-xl"></i>
        <span class="text-sm">17 mins</span>
      </div>
      <div class="flex items-center space-x-2 text-pink-800">
        <i class="fa-solid fa-bus text-xl"></i>
        <span class="text-sm">5 mins</span>
      </div>
    </div>
    <div class="mt-6">
      <button class="bg-primary-600 hover:bg-primary-700 text-white font-medium py-2 px-4 rounded-full flex items-center space-x-2">
        <i class="fa-solid fa-diamond-turn-right text-lg"></i>
        <span>Get Directions</span>
      </button>
    </div>
  </div>

  <!-- Package Cards -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 m-3">
    <% @packages.each do |package| %>
      <%= link_to venue_package_path(@venue, package), class: "block" do %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-md hover:shadow-lg transition p-4 flex items-center">
          <!-- Package Info -->
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-gray-800 mb-2"><%= package.package_name.capitalize %></h3>
            <p class="text-gray-600 text-sm mb-2"><%= package.package_description %></p>
            <% if package.package_duration %>
              <p class="text-gray-500 text-sm">Duration: <%= "#{package.package_duration} hours" %></p>
            <% end %>
            <p class="text-gray-500 text-sm font-semibold">Price: €<%= package.package_price %></p>
          </div>
          <!-- Package Image -->
          <div class="w-24 h-24 flex-shrink-0">
            <% if package.photo.key %>
              <%= cl_image_tag package.photo.key, alt: "PICTURE", class: "object-cover h-full w-full rounded-lg" %>
            <% else %>
              <%= image_tag "avatar.png", alt: "Default Image", class: "object-cover h-full w-full rounded-lg" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
