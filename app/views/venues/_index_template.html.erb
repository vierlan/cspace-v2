<div class="swiper mySwiper bg-white pb-6 px-4" data-controller="swiper">
  <h2 class="text-gray-900 font-heading font-bold text-2xl my-6 ml-2">Most popular for <%= venue_categories[index] %></h2>

  <div class="swiper-wrapper">
    <% venue_type.each_with_index do |venue, index| %>
      <div class="swiper-slide">
        <%= link_to venue_path(venue) do %>
          <div class="w-40 mb-8 max-w-sm bg-white border border-gray-300 rounded-xl shadow-lg hover:shadow-xl transition duration-200">
            <div class="relative rounded-t-xl overflow-hidden" style="padding-bottom: 75%">
              <% if venue.photos.attached? %>
                <% photo = venue.photos.first %>
                <%= cl_image_tag photo.key, alt: venue.name, class: "absolute object-cover h-full w-full" %>
              <% else %>
                <%= image_tag("img2", alt: "Venue image", class: "absolute object-cover h-full w-full") %>
              <% end %>
            </div>
            <div class="p-4">
              <h5 class="text-lg font-semibold text-gray-900 truncate">
                <%= venue.name %>
              </h5>
              <div class="mt-2 flex items-center space-x-2">
                <span class="text-gray-600 text-sm"><%= venue.categories.capitalize %></span>
                <i class="fa-regular fa-heart text-gray-400 hover:text-red-500 transition-colors duration-150"></i>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
