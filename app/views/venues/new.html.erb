<div class="grid grid-cols-8 p-10 m-4 mx-auto">
  <div class=""></div>
  <div class="col-span-8 sm:col-span-8 md:col-span-6 lg:col-span-4 bg-white rounded shadow p-4">
    <h3>List your venue</h3>
    <%= simple_form_for(@venue) do |f| %>
      <!-- Venue Name -->
      <%= f.input :name, placeholder: 'Venue' %>
      <!-- Photos -->
      <%= f.input :photos, as: :file, input_html: { multiple: true } %>
      <!-- Categories -->
      <div class="input-group">
        <%= f.label :categories %>
        <%= f.select :categories,
                     %w[bar restaurant cafe hotel other],
                     {},
                     { multiple: true, class: "form-control" } %>
      </div>
      <!-- Spaces -->
      <div class="input-group">
        <%= f.label :spaces %>
        <%= f.select :spaces,
                     %w[meeting study work],
                     {},
                     { multiple: true, class: "form-control" } %>
      </div>
      <div class="opening-hours">
        <% Date::DAYNAMES.each do |day| %>
          <div>
            <%= label_tag day %>
            <%= text_field_tag "venue[opening_hours][#{day.downcase}][0][open]", nil, placeholder: "Opening Time" %>
            <%= text_field_tag "venue[opening_hours][#{day.downcase}][0][close]", nil, placeholder: "Closing Time" %>
          </div>
        <% end %>
      </div>
      <!-- Amenities -->
      <%= f.input :amenities, placeholder: 'Describe facilities' %>
      <!-- Address -->
      <%= f.input :address, placeholder: '20 London Road, W1 4HF' %>
      <!-- Submit Button -->
      <%= f.submit "Add Venue", class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>
