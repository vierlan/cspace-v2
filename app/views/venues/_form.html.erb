<%= simple_form_for(@venue, html: { class: "space-y-6" }) do |f| %>
  <!-- Venue Name -->
  <div>
    <%= f.input :name,
                required: true,
                placeholder: 'Venue',
                label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                input_html: { class: "input-field", required: true } %>
  </div>

    <!-- Venue Address -->
  <div>
    <%= f.input :venue_email,
                placeholder: 'Enter contact email for the venue',
                label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                input_html: { class: "input-field" } %>
  </div>

  <!-- Venue Phone Number -->
  <div>
    <%= f.input :phone_number,
                placeholder: 'Enter venue phone number',
                label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                input_html: { class: "input-field", type: "tel", pattern: "[0-9+ -]+" } %>
  </div>

  <!-- Venue Website -->
  <div>
    <%= f.input :website,
                placeholder: 'Enter venue website (https://example.com)',
                label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                input_html: { class: "input-field", type: "url" } %>
  </div>
  <!-- Venue Photos -->

            <!-- photos Upload Section -->
          <div class="sm:col-span-6 mb-6 space-y-2">
            <%= f.label :photos, "Upload photos (max 20mb size)", class: "text-gray-700 font-medium whitespace-nowrap" %>
            <%= f.file_field :photos, multiple: true, class: "whitespace-nowrap", id: "photos" %>
          </div>
          <!-- Display Existing photos Files (Images/Videos) -->
          <% if @venue&.persisted? && @venue.photos.attached? %>
            <% if @venue.photos.present? %>
            <div class="images-wrapper gap-4 mt-4" data-controller="sortable">
              <% @venue.photos.each_with_index do |media_file, index| %>
                <div class="form-image-card border rounded-lg p-4 shadow-sm bg-white flex flex-col items-center"
     id="media_<%= media_file.id %>"
     data-id="<%= media_file.id %>">

  <% if media_file.image? %>
    <%= image_tag media_file, class: "uploaded-photos form-image w-full h-48 object-cover rounded-md mb-2" %>
  <% elsif media_file.video? %>
    <%= video_tag media_file, controls: true, class: "uploaded-photos form-image w-full h-48 rounded-md mb-2" %>
  <% end %>

  <!-- Hidden field to store the order of images -->
  <%= hidden_field_tag "venue[photo_positions][]", index + 1, class: "photo-position" %>

  <!-- Remove button for photo files -->
  <%= button_to "Remove", remove_photos_venue_path(@venue, photos_id: media_file.id),
      method: :delete,
      data: { turbo_confirm: "Are you sure you want to remove this photo?" },
      class: "text-sm text-red-600 hover:text-red-800 mt-2"
  %>
</div>

              <% end %>
            <% end %>
          <% end %>

  <!-- Venue Categories -->
  <div>
    <%= f.label :categories, "Categories", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :categories,
                %w[bar restaurant cafe hotel other],
                {},
                class: "input-field" %>
  </div>

        <!-- Spaces -->
      <div class="flex flex-row">
        <%= f.label :spaces %>
        <%= f.input :spaces, as: :check_boxes,
             collection: %w[meeting study work] %>
      </div>
      <div class="opening-hours grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% Date::DAYNAMES.each do |day| %>
          <div class="flex items-center space-x-4">
            <%= label_tag day %>
            <%= time_field_tag "venue[opening_hours][#{day.downcase}][0][open]",
                         nil,
                         placeholder: "Opening Time",
                         class: "w-1/3 border rounded px-2 py-1 text-sm" %>

            <%= time_field_tag "venue[opening_hours][#{day.downcase}][0][close]", nil, placeholder: "Closing Time",
                         class: "w-1/3 border rounded px-2 py-1 text-sm" %>
          </div>
        <% end %>
      </div>

  <!-- Venue Amenities -->
  <div>
    <%= f.input :amenities,
                placeholder: 'Describe facilities',
                label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                input_html: { class: "input-field" } %>
  </div>

  <!-- Venue Address -->
  <div>
    <%= f.input :address,
                placeholder: '20 London Road, W1 4HF',
                label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
                input_html: { class: "input-field" } %>
  </div>



  <p>To associate this venue with a user, please enter the user's email below.</p>

  <div id="user-email-field">
  <%= f.input :user_email,
              label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
              input_html: {
                placeholder: "Enter user email",
                class: "input-field",
                id: "user_email",
                type: "email" # HTML5 validation
              } %>
</div>

  <!-- Submit Button -->
  <div>
    <%= f.submit @venue.persisted? ? "Update Venue" : "Add Venue", class: "btn-primary w-full" %>
  </div>
<% end %>
