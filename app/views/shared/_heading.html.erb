<% description ||= '' %>
<div class="text-left">
  <!-- Title -->
  <h1 class="mt-2 ml-4 text-left font-heading text-gray-900 text-xl sm:text-5xl lg:text-6xl tracking">
    <%= title %>
  </h1>
  
  <!-- Description -->
  <% if description.present? %>
    <p class="max-w-2xl mt-4 mx-auto text-lg sm:text-xl lg:text-2xl text-gray-600 dark:text-gray-400">
      <%= description.html_safe %>
    </p>
  <% end %>
</div>
